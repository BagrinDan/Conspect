
    > Суть задачи: найти топ К повторяющихся чисел

    > Как решить: HashMap
        Формируем мапу на основе массива. Через PriorityQueue создаем очередь и получаем топ к повторяющихся элементов.
        Кладем в res и возвращаем результат

    > Код:
        Java:
            class Solution {
                public int[] topKFrequent(int[] nums, int k) {
                    Map<Integer, Integer> map = new HashMap<>();
                    int[] res = new int[k];

                    for(int i = 0; i < nums.length; i++){
                        map.put(nums[i], map.getOrDefault(nums[i], 0) + 1);
                    }

                    PriorityQueue<Integer> fifo = new PriorityQueue<>((a,b) -> map.get(a) - map.get(b));

                    for(int i : map.keySet()){
                        fifo.add(i);
                        if(fifo.size() > k){
                            fifo.poll();
                        }
                    }

                    for(int i = 0; i < k; i++){
                        res[i] = fifo.poll();
                    }

                    return res;

                }
            }